ROOT_PATH=/app
BUCKET_ID=
APPWRITE_PROJECT_ID=
APPWRITE_KEY=
# Use your project's regional endpoint, e.g. https://fra.cloud.appwrite.io/v1/s3
APPWRITE_S3_ENDPOINT=
APPWRITE_S3_REGION=auto
APPWRITE_RESPONSE_FORMAT=1.4.0
DB_HOST=dekho-postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=8000
ADDR=0.0.0.0
SSL_MODE=disable
JWT_SECRET_KEY=generate_random_value_for_this
FILE_SIZE_LIMIT=209715200
REDIS_ADDR=dekho-redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
ASYNQMON_PORT=8081
ASYNQMON_BIND_ADDRESS=127.0.0.1
ASYNQMON_READ_ONLY=true
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT=2m
VIDEO_TASK_MAX_RETRIES=5
VIDEO_TASK_TIMEOUT=6h
VIDEO_TASK_RETENTION=24h
VIDEO_TASK_UNIQUE_TTL=24h

SMTPHost=smtp.gmail.com
SMTPPort=587
SMTPUser=
SMTPPassword=
